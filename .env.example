# Copy this file to .env and fill in your real keys. .env is gitignored --
# never commit real keys.

# --- LLM providers ---
# Get a Groq key at https://console.groq.com (free, no card, ~30s signup).
GROQ_API_KEY=

# Get a Gemini key at https://aistudio.google.com/apikey (free, no card).
# Go through AI Studio, NOT Google Cloud Console -- the Cloud Console path
# drags in a billing project you don't need.
GEMINI_API_KEY=

# Order to try providers in. Groq first: higher free-tier rate limit
# (30 req/min vs Gemini's ~10), no card required either way.
LLM_PROVIDER_CHAIN=groq,gemini

GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash
# Both current as of Sep 2026 -- providers retire models with only weeks'
# notice. If /query starts returning "model_not_found" or similar 404s,
# check https://console.groq.com/docs/deprecations and the Gemini API's
# own error message (it names the replacement directly) before anything
# else -- this is the single most likely thing to break between now and
# whenever you next run this.

# --- everything below has a sensible default; override only if needed ---
# LLM_TIMEOUT_S=45
# SQL_RETRY_ATTEMPTS=1
# MAX_ROWS=200
# QUERY_TIMEOUT_S=10
# ANOMALY_NOW=            # ISO timestamp override; defaults to MAX(created_at)
# STALE_HOURS=24
# API_HOST=127.0.0.1
# API_PORT=8000
# LOG_LEVEL=INFO
